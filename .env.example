# Backend
PORT=5002
PUBLIC_API_BASE_URL=http://localhost:5002
PUBLIC_FRONTEND_URL=http://localhost:5274

# Database
MONGO_PORT=27018
MONGODB_URI=mongodb://localhost:27018/github-research

# Decodo Web Data API
# Paste your Web Data API key only (without the "Bearer" prefix).
DECODO_AUTH_TOKEN=
DECODO_SCRAPER_ENDPOINT=https://data.decodo.com/v1/scrape

# GitHub requests always use:
# proxy_pool=premium
# headless=html

# LLM Provider — pick one: claude | openai | gemini
LLM_PROVIDER=claude
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
