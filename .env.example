# Backend
PORT=5002
PUBLIC_API_BASE_URL=http://localhost:5002
PUBLIC_FRONTEND_URL=http://localhost:5274

# Database
MONGO_PORT=27018
MONGODB_URI=mongodb://localhost:27018/github-research

# Decodo Web Data API
# Optional: configure the key here OR enter it on the Settings page.
# Paste the key only, without the "Bearer" prefix.
DECODO_WEB_DATA_API_KEY=
DECODO_SCRAPER_ENDPOINT=https://data.decodo.com/v1/scrape

# GitHub requests always use:
# proxy_pool=premium
# headless=html

# LLM Provider — pick one: claude | openai | gemini
LLM_PROVIDER=claude
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: number of repositories enriched through additional Web Data API calls (0–12; default 6)
GITHUB_METADATA_ENRICH_LIMIT=6

# Optional. Backend binds to localhost by default. Use another host only
# behind an authenticated proxy when serving remotely.
HOST=127.0.0.1
# Optional directory for the locally saved Web Data API key.
# GITHUB_RESEARCH_DATA_DIR=
